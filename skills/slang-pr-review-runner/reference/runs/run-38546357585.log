##[start-action display=Obtain GitHub Token;id=__self.github-token]
##[group]Run set -euo pipefail
^[[36;1mset -euo pipefail^[[0m
^[[36;1mAUDIENCE="claude-code-github-action"^[[0m
^[[36;1mEXCHANGE_URL="https://api.anthropic.com/api/github/github-app-token-exchange"^[[0m
^[[36;1m^[[0m
^[[36;1m# Get OIDC token^[[0m
^[[36;1mif [ -z "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ] || [ -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]; then^[[0m
^[[36;1m  echo "OIDC not available, using GITHUB_TOKEN fallback"^[[0m
^[[36;1m  echo "token=$GITHUB_TOKEN" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  echo "source=github-token" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  exit 0^[[0m
^[[36;1mfi^[[0m
^[[36;1m^[[0m
^[[36;1mOIDC_TOKEN=$(curl -s -f --max-time 10 \^[[0m
^[[36;1m  -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \^[[0m
^[[36;1m  "${ACTIONS_ID_TOKEN_REQUEST_URL}&audience=${AUDIENCE}" 2>/dev/null \^[[0m
^[[36;1m  | jq -r '.value // empty' 2>/dev/null || true)^[[0m
^[[36;1m^[[0m
^[[36;1mif [ -z "$OIDC_TOKEN" ]; then^[[0m
^[[36;1m  echo "OIDC token request failed, using GITHUB_TOKEN fallback"^[[0m
^[[36;1m  echo "token=$GITHUB_TOKEN" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  echo "source=github-token" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  exit 0^[[0m
^[[36;1mfi^[[0m
^[[36;1m^[[0m
^[[36;1m# Exchange OIDC token for Claude App installation token^[[0m
^[[36;1mEXCHANGE_RESPONSE="${RUNNER_TEMP:-/tmp}/oidc_exchange.json"^[[0m
^[[36;1mHTTP_CODE=$(curl -s -w "%{http_code}" -o "$EXCHANGE_RESPONSE" --max-time 15 \^[[0m
^[[36;1m  -X POST "$EXCHANGE_URL" \^[[0m
^[[36;1m  -H "Authorization: ***" \^[[0m
^[[36;1m  -H "Content-Type: application/json" \^[[0m
^[[36;1m  -d '{"permissions":{"contents":"read","pull_requests":"write","issues":"write","actions":"read"}}' \^[[0m
^[[36;1m  2>/dev/null || echo "000")^[[0m
^[[36;1m^[[0m
^[[36;1mif [ "$HTTP_CODE" = "200" ] && [ -f "$EXCHANGE_RESPONSE" ]; then^[[0m
^[[36;1m  APP_TOKEN=$(jq -r '.token // .app_token // empty' "$EXCHANGE_RESPONSE" 2>/dev/null || true)^[[0m
^[[36;1m  if [ -n "$APP_TOKEN" ]; then^[[0m
^[[36;1m    echo "::add-mask::$APP_TOKEN"^[[0m
^[[36;1m    echo "token=$APP_TOKEN" >> $GITHUB_OUTPUT^[[0m
^[[36;1m    echo "source=claude-app" >> $GITHUB_OUTPUT^[[0m
^[[36;1m    rm -f "$EXCHANGE_RESPONSE"^[[0m
^[[36;1m    echo "Using Claude App token"^[[0m
^[[36;1m    exit 0^[[0m
^[[36;1m  fi^[[0m
^[[36;1mfi^[[0m
^[[36;1m^[[0m
^[[36;1mrm -f "$EXCHANGE_RESPONSE"^[[0m
^[[36;1mecho "OIDC exchange failed (HTTP $HTTP_CODE), using GITHUB_TOKEN fallback"^[[0m
^[[36;1mecho "token=$GITHUB_TOKEN" >> $GITHUB_OUTPUT^[[0m
^[[36;1mecho "source=github-token" >> $GITHUB_OUTPUT^[[0m
