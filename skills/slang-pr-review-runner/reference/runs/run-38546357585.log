^[[36;1m  echo "auth-provider=nv-inference" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  echo "base-url=https://inference-api.nvidia.com" >> $GITHUB_OUTPUT^[[0m
^[[36;1m^[[0m
^[[36;1m  echo "✅ NV Inference Portal token configured and masked"^[[0m
^[[36;1m^[[0m
^[[36;1melse^[[0m
^[[36;1m  #############################################^[[0m
^[[36;1m  # LLM Gateway - OAuth token generation^[[0m
^[[36;1m  #############################################^[[0m
^[[36;1m  echo "Using LLM Gateway (OAuth)"^[[0m
^[[36;1m^[[0m
^[[36;1m  # Read credentials from shell env vars^[[0m
^[[36;1m  LLMGW_ID="${LLMGW_ID}"^[[0m
^[[36;1m  LLMGW_SECRET="${LLMGW_SECRET}"^[[0m
^[[36;1m  LLMGW_TOKEN_URL="${LLMGW_TOKEN_URL}"^[[0m
^[[36;1m^[[0m
^[[36;1m  TEMP_DIR="${RUNNER_TEMP:-/tmp}"^[[0m
^[[36;1m  TOKEN_FILE="$TEMP_DIR/token_response.json"^[[0m
^[[36;1m^[[0m
^[[36;1m  # Set up error handling^[[0m
^[[36;1m  cleanup() {^[[0m
^[[36;1m    local exit_code=$?^[[0m
^[[36;1m    echo "🧹 Cleaning up temporary files..."^[[0m
^[[36;1m    rm -f "$TOKEN_FILE" 2>/dev/null || true^[[0m
^[[36;1m    if [ $exit_code -ne 0 ]; then^[[0m
^[[36;1m      echo "::error::Authentication failed - check your credentials and endpoint"^[[0m
^[[36;1m    fi^[[0m
^[[36;1m    exit $exit_code^[[0m
^[[36;1m  }^[[0m
^[[36;1m  trap cleanup EXIT^[[0m
^[[36;1m^[[0m
^[[36;1m  # Generate token with comprehensive error handling (using Basic auth)^[[0m
^[[36;1m  # Note: Use 'base64 | tr -d' instead of 'base64 -w0' for Windows Git Bash compatibility^[[0m
^[[36;1m  # Security: Mask the encoded credentials before use to prevent leaking in error output^[[0m
^[[36;1m  ENCODED_CREDS=$(echo -n "$LLMGW_ID:$LLMGW_SECRET" | base64 | tr -d '\n\r')^[[0m
^[[36;1m  echo "::add-mask::$ENCODED_CREDS"^[[0m
^[[36;1m^[[0m
^[[36;1m  HTTP_CODE=$(curl -s -w "%{http_code}" -o "$TOKEN_FILE" --fail-with-body \^[[0m
^[[36;1m    --max-time 30 \^[[0m
^[[36;1m    --retry 3 \^[[0m
^[[36;1m    --retry-delay 2 \^[[0m
^[[36;1m    --location "$LLMGW_TOKEN_URL" \^[[0m
^[[36;1m    --header 'Content-Type: application/x-www-form-urlencoded' \^[[0m
^[[36;1m    --header "Authorization: Basic $ENCODED_CREDS" \^[[0m
^[[36;1m    --data-urlencode 'grant_type=client_credentials' \^[[0m
^[[36;1m    --data-urlencode 'scope=awsanthropic-readwrite azureopenai-readwrite' \^[[0m
^[[36;1m    2>/dev/null)^[[0m
^[[36;1m^[[0m
^[[36;1m  # Check HTTP response code^[[0m
^[[36;1m  if [ "$HTTP_CODE" -ne 200 ]; then^[[0m
^[[36;1m    echo "::error::Authentication failed with HTTP code: $HTTP_CODE"^[[0m
^[[36;1m    if [ -f "$TOKEN_FILE" ]; then^[[0m
^[[36;1m      echo "::error::Response: $(cat "$TOKEN_FILE" | head -c 200)"^[[0m
^[[36;1m    fi^[[0m
^[[36;1m    exit 1^[[0m
^[[36;1m  fi^[[0m
^[[36;1m^[[0m
^[[36;1m  # Extract and validate token^[[0m
^[[36;1m  if [ ! -f "$TOKEN_FILE" ]; then^[[0m
^[[36;1m    echo "::error::No response file generated"^[[0m
^[[36;1m    exit 1^[[0m
^[[36;1m  fi^[[0m
^[[36;1m^[[0m
^[[36;1m  # Parse JSON without jq (portable for Windows Git Bash)^[[0m
^[[36;1m  ANTHROPIC_AUTH_TOKEN=$(grep -o '"access_token"[[:space:]]*:[[:space:]]*"[^"]*"' "$TOKEN_FILE" | sed 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' 2>/dev/null || true)^[[0m
^[[36;1m^[[0m
^[[36;1m  # Validate token format and length^[[0m
^[[36;1m  if [ -z "$ANTHROPIC_AUTH_TOKEN" ] || [ "$ANTHROPIC_AUTH_TOKEN" = "null" ]; then^[[0m
^[[36;1m    echo "::error::Failed to extract access token from response"^[[0m
^[[36;1m    exit 1^[[0m
^[[36;1m  fi^[[0m
^[[36;1m^[[0m
^[[36;1m  # CRITICAL: Mask the token BEFORE any output^[[0m
^[[36;1m  echo "::add-mask::$ANTHROPIC_AUTH_TOKEN"^[[0m
^[[36;1m^[[0m
^[[36;1m  if [ ${#ANTHROPIC_AUTH_TOKEN} -lt 10 ]; then^[[0m
^[[36;1m    echo "::error::Token appears to be too short (${#ANTHROPIC_AUTH_TOKEN} characters)"^[[0m
^[[36;1m    exit 1^[[0m
^[[36;1m  fi^[[0m
^[[36;1m^[[0m
^[[36;1m  # Set outputs^[[0m
^[[36;1m  echo "token=$ANTHROPIC_AUTH_TOKEN" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  echo "auth-provider=llmgw" >> $GITHUB_OUTPUT^[[0m
^[[36;1m^[[0m
^[[36;1m  # Set token expiry if available (parse without jq)^[[0m
^[[36;1m  TOKEN_EXPIRES=$(grep -o '"expires_in"[[:space:]]*:[[:space:]]*[0-9]*' "$TOKEN_FILE" | sed 's/.*"expires_in"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/' 2>/dev/null || true)^[[0m
^[[36;1m  if [ -n "$TOKEN_EXPIRES" ]; then^[[0m
^[[36;1m    echo "::add-mask::$TOKEN_EXPIRES"^[[0m
^[[36;1m    echo "token-expires=$TOKEN_EXPIRES" >> $GITHUB_OUTPUT^[[0m
^[[36;1m  fi^[[0m
^[[36;1m^[[0m
^[[36;1m  echo "✅ LLM Gateway token generated and masked successfully"^[[0m
^[[36;1m^[[0m
^[[36;1m  # Clean up response file^[[0m
^[[36;1m  rm -f "$TOKEN_FILE"^[[0m
^[[36;1mfi^[[0m
